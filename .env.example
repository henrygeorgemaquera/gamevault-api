# Copia este archivo como ".env" y completa los valores.

# Base de datos (sqlite local)
DATABASE_URL=sqlite:///./gamevault.db

# JWT (obligatorio)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Resend: correos de verificación y boleta
# API Key desde https://resend.com
RESEND_API_KEY=
# Sin dominio propio Resend solo permite este remitente de pruebas,
# y únicamente entrega al correo con el que creaste tu cuenta de Resend
EMAIL_FROM=onboarding@resend.dev

# Cloudinary: imágenes del catálogo

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Verificación de correo
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_LOCK_MINUTES=15

# Tareas programadas (APScheduler)
# Plazo para verificar la cuenta antes de que se elimine, y cada cuánto corren los jobs
UNVERIFIED_ACCOUNT_TTL_HOURS=24
JOBS_INTERVAL_MINUTES=60

# Rate limiting por IP en autenticación
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_VERIFY=10/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_LOGOUT=30/minute
